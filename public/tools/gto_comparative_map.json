{
    "name": "gto_comparative_map",
    "tool": "gto",
    "version": "1.6.3",
    "description": "Creates a visualization for comparative maps.",
    "input": {
        "type": "stdin",
        "format": "POS"
    },
    "output": {
        "type": "stdout",
        "format": "SVG"
    },
    "parameters": [
        {
            "name": "link",
            "type": "integer",
            "flag": "-l",
            "required": false
        },
        {
            "name": "width",
            "type": "integer",
            "flag": "-w",
            "required": false
        },
        {
            "name": "space",
            "type": "integer",
            "flag": "-s",
            "required": false
        },
        {
            "name": "mult",
            "type": "integer",
            "flag": "-m",
            "required": false
        },
        {
            "name": "begin",
            "type": "integer",
            "flag": "-b",
            "required": false
        },
        {
            "name": "minimum",
            "type": "integer",
            "flag": "-c",
            "required": false
        },
        {
            "name": "FILE",
            "type": "string",
            "flag": "-o",
            "required": false
        }
    ],
    "is_multi_output": false,
    "is_multi_type_output": false,
    "source": "gto/src/ComparativeMap.c",
    "category": "Information and Analysis"
}