{
    "name": "seqtk_trimfq",
    "tool": "seqtk",
    "program": "seqtk",
    "version": "1.4",
    "description": "Trim FASTQ using the Phred algorithm.",
    "input": {
        "type": "file",
        "format": "FASTQ"
    },
    "output": {
        "type": "stdout",
        "format": "FASTQ"
    },
    "parameters": [
        {
            "name": "command",
            "type": "string",
            "default": "trimfq",
            "hidden": true,
            "required": true
        },
        {
            "name": "error_rate_threshold",
            "type": "float",
            "flag": "-q",
            "default": 0.05
        },
        {
            "name": "max_trim_length",
            "type": "integer",
            "flag": "-l",
            "default": 30
        },
        {
            "name": "trim_left",
            "type": "integer",
            "flag": "-b",
            "default": 0
        },
        {
            "name": "trim_right",
            "type": "integer",
            "flag": "-e",
            "default": 0
        },
        {
            "name": "max_retain_5prime",
            "type": "integer",
            "flag": "-L",
            "default": 0
        }
    ],
    "is_multi_output": false,
    "is_multi_type_output": false
}