{
    "name": "seqtk_seq",
    "tool": "seqtk",
    "program": "seqtk",
    "version": "1.4",
    "description": "Common transformation of FASTA/Q",
    "input": {
        "type": "file",
        "format": "FASTA, FASTQ"
    },
    "output": {
        "type": "stdout",
        "format": "FASTA, FASTQ"
    },
    "parameters": [
        {
            "name": "command",
            "type": "string",
            "default": "seq",
            "hidden": true,
            "required": true
        },
        {
            "name": "quality_min",
            "type": "integer",
            "flag": "-q"
        },
        {
            "name": "quality_max",
            "type": "integer",
            "flag": "-X"
        },
        {
            "name": "mask_char",
            "type": "string",
            "flag": "-n"
        },
        {
            "name": "line_length",
            "type": "integer",
            "flag": "-l"
        },
        {
            "name": "qual_shift",
            "type": "integer",
            "flag": "-Q"
        },
        {
            "name": "seed",
            "type": "integer",
            "flag": "-s"
        },
        {
            "name": "sample_fraction",
            "type": "float",
            "flag": "-f"
        },
        {
            "name": "mask_file",
            "type": "string",
            "flag": "-M"
        },
        {
            "name": "min_length",
            "type": "integer",
            "flag": "-L"
        },
        {
            "name": "fake_qual",
            "type": "string",
            "flag": "-F"
        },
        {
            "name": "mask_complement",
            "type": "flag",
            "flag": "-c"
        },
        {
            "name": "reverse_complement",
            "type": "flag",
            "flag": "-r"
        },
        {
            "name": "both_strands",
            "type": "flag",
            "flag": "-R"
        },
        {
            "name": "force_fasta",
            "type": "flag",
            "flag": "-A"
        },
        {
            "name": "drop_comments",
            "type": "flag",
            "flag": "-C"
        },
        {
            "name": "drop_ambiguous",
            "type": "flag",
            "flag": "-N"
        },
        {
            "name": "odd_reads_only",
            "type": "flag",
            "flag": "-1"
        },
        {
            "name": "even_reads_only",
            "type": "flag",
            "flag": "-2"
        },
        {
            "name": "shift_quality",
            "type": "flag",
            "flag": "-V"
        },
        {
            "name": "uppercase_bases",
            "type": "flag",
            "flag": "-U"
        },
        {
            "name": "convert_lowercase",
            "type": "flag",
            "flag": "-x"
        },
        {
            "name": "strip_whitespace",
            "type": "flag",
            "flag": "-S"
        }
    ],
    "is_multi_output": false,
    "is_multi_type_output": false,
    "wasm": "seqtk",
    "category": ""
}