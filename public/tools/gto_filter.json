{
    "name": "gto_filter",
    "tool": "gto",
    "version": "1.6.3",
    "description": "Filters numerical sequences using a low-pass filter.",
    "input": {
        "type": "stdin",
        "format": "NUM"
    },
    "output": {
        "type": "stdout",
        "format": "NUM"
    },
    "parameters": [
        {
            "name": "windowsize",
            "type": "integer",
            "flag": "-w",
            "required": false
        },
        {
            "name": "drop",
            "type": "float",
            "flag": "-d",
            "required": false
        },
        {
            "name": "windowtype",
            "type": "integer",
            "flag": "-t",
            "required": false
        }
    ],
    "is_multi_output": false,
    "is_multi_type_output": false,
    "source": "gto/src/Filter.c",
    "category": "Text Processing"
}