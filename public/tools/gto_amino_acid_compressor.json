            "name": "level",
            "type": "integer"
        },
        {
            "name": "threshold",
            "type": "float"
        },
        {
            "name": "c",
            "type": "integer"
        },
        {
            "name": "d",
            "type": "integer"
        },
        {
            "name": "g",
            "type": "float"
        },
        {
            "name": "m",
            "type": "integer"
        },
        {
            "name": "e",
            "type": "integer"
        },
        {
            "name": "a",
            "type": "float"
        },
        {
            "name": "FILE",
            "type": "string"
        }
    ],
